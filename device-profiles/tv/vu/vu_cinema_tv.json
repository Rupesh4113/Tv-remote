{
  "id": "tv-vu-cinema",
  "brand": "Vu",
  "category": "TV",
  "model": "Cinema TV / GloLED",
  "region": "India",
  "version": "1.0.0",
  "supported_transports": ["IR", "WIFI"],
  "ir_config": {
    "protocol": "NEC",
    "carrier_frequency_hz": 38000,
    "customer_code": "0x01FE"
  },
  "wifi_config": {
    "adapter": "android_tv",
    "default_port": 6466,
    "auth_required": true,
    "auth_type": "PIN",
    "discovery_service": "_androidtvremote2._tcp.local"
  },
  "commands": {
    "POWER": { "label": "Power", "ir_hex": "0x01FE48B7", "wifi_payload": { "key_code": 26 } },
    "VOLUME_UP": { "label": "Volume +", "ir_hex": "0x01FE58A7", "wifi_payload": { "key_code": 24 } },
    "VOLUME_DOWN": { "label": "Volume -", "ir_hex": "0x01FE7887", "wifi_payload": { "key_code": 25 } },
    "MUTE": { "label": "Mute", "ir_hex": "0x01FE08F7", "wifi_payload": { "key_code": 164 } },
    "DPAD_UP": { "label": "Up", "ir_hex": "0x01FE20DF", "wifi_payload": { "key_code": 19 } },
    "DPAD_DOWN": { "label": "Down", "ir_hex": "0x01FEA05F", "wifi_payload": { "key_code": 20 } },
    "DPAD_LEFT": { "label": "Left", "ir_hex": "0x01FE609F", "wifi_payload": { "key_code": 21 } },
    "DPAD_RIGHT": { "label": "Right", "ir_hex": "0x01FEE01F", "wifi_payload": { "key_code": 22 } },
    "DPAD_OK": { "label": "OK", "ir_hex": "0x01FE10EF", "wifi_payload": { "key_code": 23 } },
    "HOME": { "label": "Home", "ir_hex": "0x01FE906F", "wifi_payload": { "key_code": 3 } },
    "BACK": { "label": "Back", "ir_hex": "0x01FEB04F", "wifi_payload": { "key_code": 4 } }
  }
}
