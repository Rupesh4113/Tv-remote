# AI Smart Remote — Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml for local development or paste into Streamlit Cloud Secrets Manager.

# AI Provider API Keys (Optional — Defaults to 100% offline LocalIntentEngine if omitted)
AI_API_KEY = "sk-..."
OPENAI_API_KEY = "sk-..."
GEMINI_API_KEY = "AIzaSy..."

# Local Remote Agent Connection
LOCAL_AGENT_URL = "http://localhost:8765"
WEBSOCKET_SECRET = "agent_default_secret_key_12345"

# Security & Authentication
JWT_SECRET = "your-secure-jwt-signing-secret-key-32chars"
DATABASE_URL = "sqlite:///backend/ai_remote.db"
